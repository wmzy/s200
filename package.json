      },
      "require": {
        "types": "./dist/types/rate-limit.d.ts",
        "default": "./dist/rate-limit.cjs"
      }
    },
    "./compress": {
      "import": {
        "types": "./dist/types/compress.d.mts",
        "default": "./dist/compress.mjs"
      },
      "require": {
        "types": "./dist/types/compress.d.ts",
        "default": "./dist/compress.cjs"
      }
    },
    "./streaming": {
      "import": {
        "types": "./dist/types/streaming.d.mts",
        "default": "./dist/streaming.mjs"
      },
      "require": {
        "types": "./dist/types/streaming.d.ts",
        "default": "./dist/streaming.cjs"
      }
    },
    "./request-id": {
      "import": {
        "types": "./dist/types/request-id.d.mts",
