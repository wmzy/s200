        "default": "./dist/route-table.cjs"
      }
    },
    "./cookies": {
      "import": {
        "types": "./dist/types/cookies.d.mts",
        "default": "./dist/cookies.mjs"
      },
      "require": {
        "types": "./dist/types/cookies.d.ts",
        "default": "./dist/cookies.cjs"
      }
    },
    "./validate": {
      "import": {
        "types": "./dist/types/validate.d.mts",
        "default": "./dist/validate.mjs"
      },
      "require": {
