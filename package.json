    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "publint": "^0.3.24",
    "size-limit": "^13.0.3",
    "tools-config": "^0.5.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0"
