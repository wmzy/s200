  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "commit": "lint-staged && git-cz -n",
    "prepare": "husky",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && node scripts/gen-dmts.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "coverage": "vitest run --coverage --coverage.reporter=lcov",
    "lint": "eslint --fix src test",
    "lint:ci": "eslint src test",
    "lint:pkg": "publint --strict",
    "attw": "attw --pack . --profile node16",
    "size": "size-limit",
    "bench": "pnpm build && node scripts/bench-router.mjs",
    "bench:http": "pnpm build && node scripts/bench-http.mjs",
    "prepublish:jsr": "node scripts/prep-jsr.mjs",
    "publish:jsr": "pnpm build && pnpm prepublish:jsr && npx jsr publish",
    "verify:tree-shaking": "node scripts/verify-tree-shaking.mjs",
    "check:paradigm": "node scripts/check-paradigm.mjs",
    "smoke": "node scripts/smoke.mjs && bun scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "start": "vitest watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmzy/s200.git"
  },
  "keywords": [
    "server",
    "framework",
    "http",
    "web-standard",
    "middleware",
    "router",
    "functional",
    "tree-shaking",
    "multi-runtime",
    "node",
    "bun"
  ],
  "author": "wmzy",
  "license": "MIT",
  "packageManager": "pnpm@11.28.0",
  "bugs": {
    "url": "https://github.com/wmzy/s200/issues"
  },
  "homepage": "https://github.com/wmzy/s200#readme",
  "files": [
    "dist",
    "src"
  ],
  "size-limit": [
    {
      "name": "full library: dist/index.mjs entry + shared chunk (min+gz)",
      "path": "dist/index.mjs",
      "gzip": true,
      "limit": "8.3 KB"
    },
    {
      "name": "minimal usage: createApp/use/get/handle (min+gz)",
      "path": "src/index.ts",
      "import": "{ createApp, use, get, handle }",
      "gzip": true,
      "limit": "4.4 KB"
    },
    {
      "name": "node adapter: dist/node.mjs (min+gz, shared core chunk measured by the full-library entry)",
      "path": "dist/node.mjs",
      "ignore": [
        "node:*"
      ],
      "gzip": true,
      "limit": "4.4 KB"
    },
    {
      "name": "compress battery (min+gz)",
      "path": "dist/compress.mjs",
      "gzip": true,
      "limit": "2.3 KB"
    },
    {
      "name": "streaming battery (min+gz)",
      "path": "dist/streaming.mjs",
      "gzip": true,
      "limit": "2.1 KB"
    },
    {
      "name": "request-id battery (min+gz)",
      "path": "dist/request-id.mjs",
      "gzip": true,
      "limit": "0.6 KB"
    },
    {
      "name": "timeout battery (min+gz)",
      "path": "dist/timeout.mjs",
      "gzip": true,
      "limit": "0.6 KB"
    },
    {
      "name": "serialize battery (min+gz)",
      "path": "dist/serialize.mjs",
      "gzip": true,
      "limit": "2.6 KB"
    },
    {
      "name": "openapi battery: meta + openapi (min+gz)",
      "path": "src/openapi.ts",
      "import": "{ openapiSpec, openapiJson }",
      "gzip": true,
      "limit": "2.4 KB"
    },
    {
      "name": "dev battery (min+gz)",
      "path": "dist/dev.mjs",
      "ignore": [
        "node:*"
      ],
      "gzip": true,
      "limit": "1 KB"
    },
    {
      "name": "lifecycle battery (min+gz)",
      "path": "dist/lifecycle.mjs",
      "gzip": true,
      "limit": "1 KB"
    },
    {
      "name": "health battery (min+gz)",
      "path": "dist/health.mjs",
      "gzip": true,
      "limit": "2.2 KB"
    },
    {
      "name": "config battery (min+gz)",
      "path": "dist/config.mjs",
      "gzip": true,
      "limit": "1.5 KB"
    },
    {
      "name": "schedule battery (min+gz)",
      "path": "dist/schedule.mjs",
      "gzip": true,
      "limit": "2 KB"
    },
    {
      "name": "events battery (min+gz)",
      "path": "dist/events.mjs",
      "gzip": true,
      "ignore": [
        "@for-fun/*"
      ],
      "limit": "1 KB"
    },
    {
      "name": "version battery (min+gz)",
      "path": "dist/version.mjs",
      "gzip": true,
      "limit": "1 KB"
    },
    {
      "name": "shard battery (min+gz)",
      "path": "dist/shard.mjs",
      "gzip": true,
      "limit": "1.6 KB"
    },
    {
      "name": "gateway battery (min+gz)",
      "path": "dist/gateway.mjs",
      "gzip": true,
      "limit": "1.6 KB"
    },
    {
      "name": "shard-dev battery (min+gz)",
      "path": "dist/shard-dev.mjs",
      "gzip": true,
      "limit": "2.8 KB"
    },
    {
      "name": "executor battery (min+gz)",
      "path": "dist/executor.mjs",
      "ignore": [
        "node:*"
      ],
      "gzip": true,
      "limit": "8.2 KB"
    },
    {
      "name": "unit-metrics battery (min+gz)",
      "path": "dist/unit-metrics.mjs",
      "ignore": [
        "node:*"
      ],
      "gzip": true,
      "limit": "2.2 KB"
    }
  ],
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
