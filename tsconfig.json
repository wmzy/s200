{
  "extends": "tools-config/typescript",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // The default `**/*` walk skips dot-directories, which silently dropped
  // docs-site/.vitepress/config.mts from the project (and from ESLint's
  // project service). Name it explicitly.
  "include": ["**/*", "docs-site/.vitepress/config.mts"],
  "exclude": ["dist", "coverage", "eslint.config.js", "examples", "scripts"]
}
