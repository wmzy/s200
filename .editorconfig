# EditorConfig is awesome: http://EditorConfig.org

# top-most properties file, and marks the root
root = true

# Unix-style newlines with a newline ending every file
[**]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[**.{js, json}]
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
quote_type = single

[**.{yml, html, css}]
trim_trailing_whitespace = true
indent_style = tab

[**.md]
indent_style = tab
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
